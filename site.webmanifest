---
layout: null
sitemap:
  exclude: 'yes'
---
{
  "name": "{{ site.title }}",
  "short_name": "G. Stilo",
  "icons": [
    { "src": "{{ '/assets/img/favicon/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/favicon/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#0f1b2f",
  "background_color": "#f7f5f0",
  "display": "browser"
}
